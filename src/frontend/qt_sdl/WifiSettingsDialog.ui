             </property>
             <property name="maximum">
              <number>65535</number>
             </property>
             <property name="value">
              <number>60000</number>
             </property>
            </widget>
           </item>
           <item>
            <spacer name="horizontalSpacerPortRange">
             <property name="orientation">
